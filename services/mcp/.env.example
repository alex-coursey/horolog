# Copy these values into your service manager or shell environment.
# Keep the real values out of Git.
HOROLOG_API_URL=http://127.0.0.1:8000
HOROLOG_MCP_HOST=127.0.0.1
HOROLOG_MCP_PORT=8100
HOROLOG_MCP_RESOURCE_URL=https://mcp.example.com/mcp
HOROLOG_OAUTH_ISSUER=https://auth.example.com/
HOROLOG_OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
HOROLOG_OAUTH_CLIENT_ID=replace-with-your-oauth-client-id
HOROLOG_OAUTH_SUBJECT=replace-with-your-user-subject
# Optional: set if your provider puts a different audience in its access tokens.
# HOROLOG_OAUTH_AUDIENCE=replace-with-token-audience
